# ==============================================================================
# Zarkhez (زرخیز) - Environment Configuration Template
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any real API keys to version control.
# ==============================================================================

# Google Gemini API (Server routes only: /api/scan/quick, /api/scan/detail, /api/chat)
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_DETAIL=gemini-3.5-flash-lite

# Azure Speech Services (Pakistani Urdu neural voices ONLY: ur-PK-UzmaNeural, ur-PK-AsadNeural)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ElevenLabs v3 (Optional premium Urdu & Sindhi neural voices)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_UR_FEMALE=
ELEVENLABS_VOICE_UR_MALE=
ELEVENLABS_VOICE_SD_FEMALE=
ELEVENLABS_VOICE_SD_MALE=

# Open-Source Sindhi Model Endpoint (Optional MMS / VITS / XTTS server e.g. facebook/mms-tts-snd)
MMS_SINDHI_TTS_URL=

# Google Cloud Text-to-Speech (Optional backup Urdu / Sindhi Chirp HD / WaveNet)
GOOGLE_TTS_API_KEY=

# Speech-to-Text Providers (Optional Whisper / AssemblyAI fallback beside Gemini Audio STT)
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=

# Admin Diagnostics Dashboard (Comma-separated admin emails & optional >=16 char server secret)
ADMIN_EMAILS=admin@zarkhez.pk,zameer@zarkhez.pk
ADMIN_DIAGNOSTICS_SECRET=

# Supabase (Postgres, Auth, Storage, RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (Optional Real-Time Google Account Chooser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Upstash Redis (Optional for serverless rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
