# ==============================================================================
# Zarkhez (زرخیز) - Environment Configuration Template
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any real API keys to version control.
# ==============================================================================

# Google Gemini API (Server routes only: /api/scan/quick, /api/scan/detail, /api/chat)
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-1.5-flash
GEMINI_MODEL_DETAIL=gemini-1.5-pro

# Azure Speech Services (Natural Pakistani Urdu neural voices: ur-PK-UzmaNeural, ur-PK-AsadNeural)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Google Cloud Text-to-Speech (Optional backup Urdu TTS: ur-IN-Wavenet-A)
GOOGLE_TTS_API_KEY=

# Admin Exhibition Dashboard (Comma-separated admin emails allowed at /admin)
ADMIN_EMAILS=admin@zarkhez.pk,zameer@zarkhez.pk

# Supabase (Postgres, Auth, Storage, RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (Optional Real-Time Google Account Chooser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Upstash Redis (Optional for serverless rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
